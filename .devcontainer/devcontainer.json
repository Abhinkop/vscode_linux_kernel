{
  "name": "Linux Kernel Dev (ARM64/VirtIO)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // The base image's "vscode" user is UID/GID 1000. The Dev Containers CLI
  // remaps it to match the host user automatically (updateRemoteUserUID
  // defaults to true) — no manual build args needed.
  "remoteUser": "vscode",
  // gdb needs ptrace, which Docker's default seccomp profile blocks.
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  // Named volume so ccache survives container rebuilds even though it's
  // not part of the bind-mounted kernel tree. Also bind-mounts just your
  // host's mutt config file (not the whole ~/.mutt/ dir -- cache/ and
  // certificates/ in there need to stay writable for header caching and
  // cert trust updates, and are fine being built fresh inside the
  // container rather than shared from the host).
  //
  // ${localEnv:HOME} resolves on your HOST machine at container-create
  // time — safe to commit, since it's a path reference, not a secret.
  // Adjust the source path if your muttrc lives elsewhere (e.g. plain
  // ~/.muttrc instead of ~/.mutt/muttrc).
  "mounts": [
    "source=kdev-ccache,target=/home/vscode/.cache/ccache,type=volume",
    "source=${localEnv:HOME}/.mutt/muttrc,target=/home/vscode/.mutt/muttrc,type=bind,consistency=cached,readonly"
  ],
  "customizations": {
    "vscode": {
      // Kernel style / editor settings live in .vscode/settings.json in the
      // repo itself (already provided) — picked up automatically, no need
      // to duplicate here.
      "extensions": [
        // Florent Revest's reference Linux kernel dev extension set
        // (github.com/FlorentRevest/linux-kernel-vscode) plus shell-format.
        "florent-revest.patchwork",
        "florent-revest.git-send-email",
        "florent-revest.vscode-syzlang",
        "florent-revest.syzkaller-coverage",
        "florent-revest.addr2line",
        "florent-revest.systemtap-assistant",
        "llvm-vs-code-extensions.vscode-clangd",
        "13xforever.language-x86-64-assembly",
        "plorefice.devicetree",
        "luveti.kconfig",
        "idanp.checkpatch",
        "eamodio.gitlens",
        "ms-vscode.cpptools",
        "MKornelsen.vscode-arm64",
        "nzh21.systemtap-syntax",
        "shardulm94.trailing-spaces",
        "foxundermoon.shell-format",
        "anthropic.claude-code"
      ]
    }
  }
}
